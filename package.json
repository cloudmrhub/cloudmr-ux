{
  "name": "cloudmr-ux",
  "version": "2.0.6",
  "author": "erosmontin@gmail.com",
  "license": "MIT",
  "repository": "erosmontin/cloudmr-ux",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core/features/authenticate/authenticateSlice": {
      "types": "./dist/core/features/authenticate/authenticateSlice.d.ts",
      "default": "./dist/core/features/authenticate/authenticateSlice.js"
    },
    "./core/features/authenticate/authenticateActionCreation": {
      "types": "./dist/core/features/authenticate/authenticateActionCreation.d.ts",
      "default": "./dist/core/features/authenticate/authenticateActionCreation.js"
    },
    "./core/features/data/dataSlice": {
      "types": "./dist/core/features/data/dataSlice.d.ts",
      "default": "./dist/core/features/data/dataSlice.js"
    },
    "./core/features/data/dataActionCreation": {
      "types": "./dist/core/features/data/dataActionCreation.d.ts",
      "default": "./dist/core/features/data/dataActionCreation.js"
    },
    "./core/common/utilities/*": {
      "types": "./dist/core/common/utilities/*.d.ts",
      "default": "./dist/core/common/utilities/*.js"
    },
    "./core/common/components/footer/Footer": {
      "types": "./dist/core/common/components/footer/Footer.d.ts",
      "default": "./dist/core/common/components/footer/Footer.js"
    },
    "./core/common/components/CmrColorPicker/CmrColorPicker": {
      "types": "./dist/core/common/components/CmrColorPicker/CmrColorPicker.d.ts",
      "default": "./dist/core/common/components/CmrColorPicker/CmrColorPicker.js"
    },
    "./core/config/AppConfig": {
      "types": "./dist/core/config/AppConfig.d.ts",
      "default": "./dist/core/config/AppConfig.js"
    },
    "./core/store/hooks": {
      "types": "./dist/core/store/hooks.d.ts",
      "default": "./dist/core/store/hooks.js"
    },
    "./core/store/configureStore": {
      "types": "./dist/core/store/configureStore.d.ts",
      "default": "./dist/core/store/configureStore.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "find src -name '*.scss' -o -name '*.css' | while read file; do mkdir -p \"dist/$(dirname \"${file#src/}\")\" && cp \"$file\" \"dist/${file#src/}\"; done"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "process": "^0.11.10",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^6.7.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^5.14.1",
    "@mui/material": "^5.14.2",
    "@mui/x-data-grid": "^6.10.1",
    "antd": "^5.22.1",
    "axios": "1.10.0",
    "css-loader": "^7.1.2",
    "react-select": "^5.10.2",
    "sass": "^1.81.0",
    "sass-loader": "^16.0.3",
    "style-loader": "^4.0.0"
  }
}
