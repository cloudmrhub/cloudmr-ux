{
    "compilerOptions": {
        "module": "ES2015",
        "moduleResolution": "node",
        "ignoreDeprecations": "6.0",
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "outDir": "dist",
        "rootDir": "./src",
        "strict": true,
        "allowJs": true,
        "checkJs": false
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
